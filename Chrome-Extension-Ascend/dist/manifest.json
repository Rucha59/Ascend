{
  "manifest_version": 3,
  "name": "Ascend — Habit & Productivity Companion",
  "version": "1.0.0",
  "description": "Your daily companion for tracking habits, tasks, projects, and milestones with Ascend.",
  "permissions": [
    "sidePanel",
    "storage",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*.onrender.com/*",
    "https://*.supabase.co/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Ascend Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
